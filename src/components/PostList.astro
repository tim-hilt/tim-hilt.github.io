---
import { type Post, postUrl } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	/** Rendered in the given order. */
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul>
	{posts.map((post) => (
		<li>
			<FormattedDate date={post.data.pubDate} />
			<a href={postUrl(post)}>{post.data.title}</a>
		</li>
	))}
</ul>
<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		display: flex;
		gap: 1rem;
		padding: 0.25rem 0;
	}
	li :global(time) {
		flex-shrink: 0;
		min-width: 7rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
</style>
