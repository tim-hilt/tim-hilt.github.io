---
// "© <year> <site title>". The name is a mailto link styled like plain text;
// only the pointer cursor reveals it's clickable.
import { EMAIL, SITE_TITLE } from '../consts';
---

<span>
	&copy; {new Date().getFullYear()}{' '}
	<a class="easter-egg" href={`mailto:${EMAIL}`}>
		{SITE_TITLE}
	</a>
</span>

<style>
	.easter-egg,
	.easter-egg:hover,
	.easter-egg:visited {
		color: inherit;
		text-decoration: none;
		cursor: pointer;
	}
</style>
