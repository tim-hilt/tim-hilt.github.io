---
// "© <year> <site title>". The name is a disguised mailto link: it looks and
// behaves like plain text unless clicked.
import { EMAIL, SITE_TITLE } from '../consts';
---

<span>
	&copy; {new Date().getFullYear()}{' '}
	<a class="easter-egg" href={`mailto:${EMAIL}`}>
		{SITE_TITLE}
	</a>
</span>

<style>
	.easter-egg,
	.easter-egg:hover,
	.easter-egg:visited {
		color: inherit;
		text-decoration: none;
		cursor: text;
	}
</style>
