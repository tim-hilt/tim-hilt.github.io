---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">
			{SITE_TITLE}
		</a>
		<HeaderLink href="/blog">Blog</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
		<div class="right">
			<SocialLinks />
			<ThemeToggle />
		</div>
	</nav>
</header>
<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1rem 1.5rem;
	}
	.site-title {
		font-weight: 600;
		white-space: nowrap;
		color: var(--text);
		text-decoration: none;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-left: auto;
	}
	@media (max-width: 30rem) {
		nav {
			gap: 1rem;
			padding: 1rem;
		}
		.right {
			gap: 1rem;
		}
		/* Social links are also in the footer. */
		.right :global(.social-links) {
			display: none;
		}
	}
</style>
