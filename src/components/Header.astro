---
import { SITE_TITLE } from '../consts';
import Copyright from './Copyright.astro';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">
			{SITE_TITLE}
		</a>
		<!--
			Desktop: .dock and .dock-bar are `display: contents`, so everything
			flows inline in the nav. Mobile: .dock becomes a floating pill at the
			bottom of the screen that expands upward to reveal the menu.
		-->
		<div class="dock">
			<div class="menu" id="nav-menu">
				<div class="menu-inner">
					<HeaderLink href="/blog">Blog</HeaderLink>
					<HeaderLink href="/about">About</HeaderLink>
					<ThemeToggle />
					<small class="copyright">
						<Copyright />
					</small>
				</div>
			</div>
			<div class="dock-bar">
				<button
					type="button"
					class="menu-toggle"
					aria-controls="nav-menu"
					aria-expanded="false"
					aria-label="Open menu"
				>
					<span class="bars" aria-hidden="true">
						<span class="bar top"></span>
						<span class="bar middle"></span>
						<span class="bar bottom"></span>
					</span>
				</button>
				<span class="divider" aria-hidden="true"></span>
				<SocialLinks />
			</div>
		</div>
	</nav>
</header>

<script>
	// The dock's `open` class drives all open-state styling; the toggle's
	// aria-expanded mirrors it for assistive tech.
	const dock = document.querySelector<HTMLElement>('.dock')!;
	const toggle = dock.querySelector<HTMLButtonElement>('.menu-toggle')!;

	function isOpen() {
		return dock.classList.contains('open');
	}

	function setOpen(open: boolean) {
		dock.classList.toggle('open', open);
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	}

	toggle.addEventListener('click', () => setOpen(!isOpen()));

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && isOpen()) {
			setOpen(false);
			toggle.focus();
		}
	});

	// Close when tapping anywhere outside the dock.
	document.addEventListener('click', (event) => {
		if (isOpen() && !dock.contains(event.target as Node)) setOpen(false);
	});

	// Close when leaving the mobile layout (same breakpoint as the CSS) so the
	// menu isn't stuck open when resizing back.
	window.matchMedia('(max-width: 40rem)').addEventListener('change', (event) => {
		if (!event.matches) setOpen(false);
	});
</script>

<style>
	header {
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1rem 1.5rem;
	}
	.site-title {
		font-weight: 600;
		white-space: nowrap;
		color: var(--text);
		text-decoration: none;
	}

	/*
	 * Desktop: menu items flow inline in the nav. DOM order is mobile-first
	 * (menu above dock bar), so `order` moves the social links before the
	 * theme toggle to keep the toggle at the far right.
	 */
	.dock,
	.dock-bar,
	.menu,
	.menu-inner {
		display: contents;
	}
	.menu :global(.theme-toggle) {
		order: 3;
	}
	.dock-bar > :global(.social-links) {
		order: 2;
		margin-left: auto;
		margin-right: -0.75rem; /* tighten gap to theme toggle */
	}
	.menu-toggle,
	.divider,
	.copyright {
		display: none;
	}

	@media (max-width: 40rem) {
		nav {
			padding: 1rem;
		}

		/* Keep page content (and the footer) clear of the floating dock. */
		:global(body) {
			padding-bottom: 5rem;
		}

		/* Floating pill that grows upward into a card when opened. */
		.dock {
			position: fixed;
			z-index: 100;
			left: 50%;
			bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
			translate: -50% 0;
			display: flex;
			flex-direction: column;
			min-width: 12rem;
			padding: 0.375rem;
			border: 1px solid var(--border);
			border-radius: 1.5rem;
			background: color-mix(in oklch, var(--bg) 82%, transparent);
			-webkit-backdrop-filter: blur(12px) saturate(1.4);
			backdrop-filter: blur(12px) saturate(1.4);
			box-shadow:
				0 1px 2px oklch(0% 0 0 / 8%),
				0 8px 24px oklch(0% 0 0 / 14%);
			transition: border-radius 0.3s ease;
		}
		.dock.open {
			border-radius: 1.25rem;
		}

		.dock-bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			padding-right: 0.625rem;
		}
		.dock-bar > :global(.social-links) {
			margin: 0;
			gap: 1rem;
		}
		.divider {
			display: block;
			align-self: stretch;
			width: 1px;
			margin: 0.375rem 0;
			background: var(--border);
		}

		.menu-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			width: 2.5rem;
			height: 2.5rem;
			padding: 0;
			border: none;
			border-radius: 999px;
			background: none;
			color: var(--muted);
			cursor: pointer;
			transition: background-color 0.2s ease;
		}
		.menu-toggle:hover,
		.menu-toggle[aria-expanded='true'] {
			color: var(--text);
		}
		.menu-toggle[aria-expanded='true'] {
			background: var(--surface-active);
		}
		.menu-toggle:focus-visible {
			outline: 2px solid var(--moss);
			outline-offset: 1px;
		}
		.bars {
			position: relative;
			width: 1.125rem;
			height: 0.875rem;
		}
		.bar {
			position: absolute;
			left: 0;
			width: 100%;
			height: 2px;
			border-radius: 1px;
			background: currentColor;
			transition:
				transform 0.25s ease,
				opacity 0.2s ease;
		}
		.top {
			top: 0;
		}
		.middle {
			top: calc(50% - 1px);
		}
		.bottom {
			bottom: 0;
		}
		.menu-toggle[aria-expanded='true'] .top {
			transform: translateY(calc(0.4375rem - 1px)) rotate(45deg);
		}
		.menu-toggle[aria-expanded='true'] .middle {
			opacity: 0;
		}
		.menu-toggle[aria-expanded='true'] .bottom {
			transform: translateY(calc(-0.4375rem + 1px)) rotate(-45deg);
		}

		/* Animate height via grid rows (0fr -> 1fr) plus fade/slide. */
		.menu {
			display: grid;
			grid-template-rows: 0fr;
			opacity: 0;
			visibility: hidden;
			transition:
				grid-template-rows 0.3s ease,
				opacity 0.2s ease,
				visibility 0s linear 0.3s;
		}
		.dock.open .menu {
			grid-template-rows: 1fr;
			opacity: 1;
			visibility: visible;
			transition:
				grid-template-rows 0.3s ease,
				opacity 0.25s ease 0.05s,
				visibility 0s;
		}
		.menu-inner {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.25rem;
			min-height: 0;
			overflow: hidden;
			transform: translateY(0.5rem);
			transition: transform 0.3s ease;
		}
		.dock.open .menu-inner {
			transform: none;
		}
		.menu-inner > :global(a) {
			align-self: stretch;
			text-align: center;
			padding: 0.5rem 0.75rem;
			border-radius: 0.75rem;
			font-size: 1.0625rem;
		}
		.menu-inner > :global(a.active) {
			background: var(--surface-active);
		}
		.menu :global(.theme-toggle) {
			order: 0;
			margin: 0.25rem 0.5rem;
		}
		/* Footer is hidden on mobile, so the copyright lives in the menu. */
		.copyright {
			display: block;
			order: 0;
			margin: 0.25rem 0.75rem 0;
			color: var(--muted);
			font-size: 0.8125rem;
		}
		/* Separator between menu and bar; lives inside so it collapses too. */
		.menu-inner::after {
			content: '';
			order: 1;
			align-self: stretch;
			margin: 0.25rem 0 0.375rem;
			border-top: 1px solid var(--border);
		}
		.menu-inner > :global(:first-child) {
			margin-top: 0.25rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.dock,
		.bar,
		.menu,
		.dock.open .menu,
		.menu-inner,
		.menu-toggle {
			transition: none;
		}
	}
</style>
