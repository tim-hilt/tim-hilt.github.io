---
// Imported here so global styles are included on every page.
import '../styles/global.css';
import { RSS_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { THEME_STORAGE_KEY } from '../lib/theme';

export interface Props {
	/** Page-specific title; the site title is appended. Omit on the home page. */
	title?: string;
	/** Summary for search results and link previews. Defaults to the site description. */
	description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const documentTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />

<!-- Apply a stored theme before first paint to avoid a flash; default follows the system. -->
<script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
	try {
		const theme = localStorage.getItem(storageKey);
		if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
	} catch {}
</script>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(RSS_URL, Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />

<title>{documentTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title ?? SITE_TITLE} />
<meta property="og:description" content={description} />
