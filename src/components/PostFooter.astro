---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
---

<footer class="post-footer">
	<hr />
	<p>
		Thanks for reading! If you want to stay up to date with my writing, you can subscribe to my blog
		via <a href="/rss.xml">RSS</a> or connect with me on <a
			href={LINKEDIN_URL}
			target="_blank"
			rel="noopener noreferrer">LinkedIn</a
		> and <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>.
	</p>
</footer>
<style>
	.post-footer {
		margin-top: 3rem;
	}
</style>
