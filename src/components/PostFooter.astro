---
import ExternalLink from './ExternalLink.astro';
import { GITHUB_URL, LINKEDIN_URL, RSS_URL } from '../consts';
---

<footer class="post-footer">
	<hr />
	<p>
		Thanks for reading! If you want to stay up to date with my writing, you can subscribe to my blog
		via <a href={RSS_URL}>RSS</a> or connect with me on{' '}
		<ExternalLink href={LINKEDIN_URL}>LinkedIn</ExternalLink> and{' '}
		<ExternalLink href={GITHUB_URL}>GitHub</ExternalLink>.
	</p>
</footer>
<style>
	.post-footer {
		margin-top: 3rem;
	}
</style>
