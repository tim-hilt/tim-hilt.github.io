---
import type { HTMLAttributes } from 'astro/types';

/**
 * Top-level navigation link. `href` must be a site section such as `/blog`;
 * the link is marked active on that page and on every page beneath it.
 */
type Props = HTMLAttributes<'a'> & { href: string };

const { href, class: className, ...props } = Astro.props;
const currentSection = '/' + Astro.url.pathname.split('/')[1];
const isActive = href === currentSection;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover,
	a.active {
		color: var(--text);
	}
</style>
