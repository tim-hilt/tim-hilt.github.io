---
import Copyright from './Copyright.astro';
import SocialLinks from './SocialLinks.astro';
---

<footer>
	<Copyright />
	<span aria-hidden="true">&sdot;</span>
	<SocialLinks />
</footer>
<style>
	footer {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2rem 1rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	/* Mobile breakpoint, see Header.astro: its dock menu shows the copyright and socials instead. */
	@media (max-width: 40rem) {
		footer {
			display: none;
		}
	}
</style>
