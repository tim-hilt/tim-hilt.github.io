---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}
</footer>
<style>
	footer {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2rem 1rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.875rem;
	}
</style>
