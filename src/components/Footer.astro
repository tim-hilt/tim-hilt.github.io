---
import { SITE_TITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	<span>
		&copy; {today.getFullYear()}{' '}
		<a class="easter-egg" href="mailto:timhilt@live.de">
			{SITE_TITLE}
		</a>
	</span>
	<span aria-hidden="true">&sdot;</span>
	<SocialLinks />
</footer>
<style>
	footer {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2rem 1rem;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.easter-egg,
	.easter-egg:hover,
	.easter-egg:visited {
		color: inherit;
		text-decoration: none;
		cursor: text;
	}
	/* On mobile, copyright moves into the dock menu and socials live in the pill. */
	@media (max-width: 40rem) {
		footer {
			display: none;
		}
	}
</style>
